{
  "host": "127.0.0.1",
  "port": 8765,
  "repoPath": "/ABSOLUTE/PATH/TO/SHARED/REPOSITORY",
  "holdSec": 180,
  "noProgressHoldSec": 50,
  "progressIntervalSec": 20,
  "stallThresholdSec": 120,
  "presenceTtlSec": 90,
  "repoPollIntervalSec": 10,
  "maxTranscriptMessages": 300,
  "maxQueueMessages": 100,
  "maxWaitersPerAgent": 20,
  "maxControlPayloadBytes": 16384,
  "roles": {
    "claude": {
      "role": "implementer",
      "task": "Implement the requested change in repoPath, then send Codex a short review request."
    },
    "codex": {
      "role": "reviewer",
      "task": "Wait for Claude, read the changed files directly from repoPath, and send concise review findings."
    }
  }
}
